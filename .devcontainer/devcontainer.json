{
  "name": "INTACT Threat Modelling sandbox",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "secrets": {
    "GROQ_API_KEY": {
      "description": "Optional. Enables LLM-generated attack scenarios (Groq). Without it the sandbox uses deterministic scenarios.",
      "documentationUrl": "https://console.groq.com/keys"
    },
    "NVD_API_KEY": {
      "description": "Optional. Raises the NVD rate limit from 5 to 50 requests per 30 s.",
      "documentationUrl": "https://nvd.nist.gov/developers/request-an-api-key"
    }
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && (python scripts/update_data.py --dest data || true)",
  "postStartCommand": "bash sandbox/start.sh",
  "forwardPorts": [5000, 5100],
  "portsAttributes": {
    "5000": { "label": "Threat Modelling API (/api/docs)", "onAutoForward": "notify" },
    "5100": { "label": "Mock Risk Assessment", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["sandbox/README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "humao.rest-client", "redhat.vscode-yaml"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
