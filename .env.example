# ---- LLM (Groq) ----
# LLM_PROVIDER: groq, or none for deterministic LLM-free output
LLM_PROVIDER=groq
GROQ_API_KEY=
# check Groq's current model list
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_MAX_CONCURRENCY=4
SCENARIOS_PER_CVE=3
# true = send only product data (from the CPE) and asset ids to the LLM, no asset names/locations
LLM_REDACT_ASSET_DETAILS=false

# ---- Data sources ----
# free key: https://nvd.nist.gov/developers/request-an-api-key (10x rate limit)
NVD_API_KEY=
KEV_ENABLED=true
EPSS_ENABLED=true
THREAT_MODEL_LIMIT=5
# above this many NVD matches, the newest N plus all CISA KEV entries are ranked
NVD_MAX_RESULTS=2000
# telecom | health | transport | nuclear | smart_city | generic
DEFAULT_PILOT=generic

# ---- Security ----
AUTH_ENABLED=true
KEYCLOAK_SERVER_URL=https://keycloak.example.org
KEYCLOAK_REALM=INTACT
KEYCLOAK_CLIENT_ID=threat-modelling
KEYCLOAK_REQUIRED_ROLE=
# per-pilot access: role "pilot:<key>" (or "pilot:all") is needed to analyse / read that pilot
PILOT_ROLE_PREFIX=
CORS_ORIGINS=https://dashboard.example.org

# ---- Persistence ----
SQLALCHEMY_DATABASE_URI=postgresql://tm:tm@db:5432/threat_modelling

# ---- INTACT Risk Assessment service ----
RISK_ASSESSMENT_TOKEN=
RISK_ASSESSMENT_GET_TOPOLOGY_URL=https://risk.example.org/api/topologies/{topology_id}/assets
RISK_ASSESSMENT_GET_ASSET_URL=https://risk.example.org/api/assets/{asset_id}

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_REQUEST_TOPIC=threat-modeling-topic
KAFKA_RESULT_TOPIC=threat-modeling-results
KAFKA_DLQ_TOPIC=threat-modeling-dlq
# secured brokers, e.g. SASL_SSL + SCRAM-SHA-512
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=
KAFKA_MAX_ATTEMPTS=3

# ---- Async jobs ----
JOB_MAX_PENDING=20
JOB_TIMEOUT_SECONDS=3600
